# Server-only environment variables (set these in Netlify > Site settings > Environment)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/contestracker
JWT_SECRET=your_jwt_secret_key

# Email (SMTP) for OTP delivery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="My App <noreply@yourapp.com>"
# Optional: send real emails in development
EMAIL_SEND_IN_DEV=false

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: override callback URL (default: {APP_URL}/api/auth/google/callback)
GOOGLE_REDIRECT_URI=
# Public app URL used for redirects after Google login
APP_URL=http://localhost:4321

# Optional: used by the frontend build to target a separate API host
# VITE_API_BASE_URL=https://contestracker.netlify.app/
