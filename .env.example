# MongoDB Connection
PUBLIC_MONGODB_URI=mongodb://localhost:27017/codeforces-portal
# Or use MONGODB_URI for private connection string
# MONGODB_URI=mongodb://username:password@localhost:27017/your_database

# JWT Configuration
PUBLIC_JWT_SECRET=your_jwt_secret_key
# Or use JWT_SECRET for private key
# JWT_SECRET=your_private_jwt_secret_key