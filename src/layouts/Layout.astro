---
import "@/styles/global.css";
import RootLayout from "@/layouts/Layout";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Codeforces Portal - Your competitive programming companion"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/prize.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <RootLayout client:load>
      <slot />
    </RootLayout>
  </body>
</html>
