{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/forgot-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/reset-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/send-otp/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/verify-otp/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/contestants/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/userApi/allUser/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/userApi/codeforces/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/userApi/profileCreate/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/userApi/upComingContest/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/userApi/([^/]+?)/?$",
			"dest": "_render"
		}
	]
}